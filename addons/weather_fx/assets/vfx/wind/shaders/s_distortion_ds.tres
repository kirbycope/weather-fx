code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded, fog_disabled;

uniform bool Soft_Distortion;
uniform vec2 Scale_Water = vec2(1.000000, 1.000000);
uniform vec2 Speed_X_Y = vec2(1.000000, 1.000000);
uniform sampler2D NORMAL_MAP_WATER : hint_normal, filter_linear;
uniform float RefStregnht = 0.01999999955297;
uniform sampler2D Texture_mask : source_color, repeat_disable;
uniform sampler2D Texture2DParameter : source_color, filter_linear, repeat_disable, hint_screen_texture;



void vertex() {
// GetBillboardMatrix:2
	// Node is disabled and code is not generated.
}

void fragment() {
// BooleanParameter:44
	bool n_out44p0 = Soft_Distortion;


// Input:4
	vec2 n_out4p0 = SCREEN_UV;


// Vector2Parameter:23
	vec2 n_out23p0 = Scale_Water;


// UVFunc:22
	vec2 n_in22p2 = vec2(0.00000, 0.00000);
	vec2 n_out22p0 = (UV - n_in22p2) * n_out23p0 + n_in22p2;


// Input:18
	float n_out18p0 = TIME;


// Vector2Parameter:20
	vec2 n_out20p0 = Speed_X_Y;


// VectorOp:21
	vec2 n_out21p0 = vec2(n_out18p0) * n_out20p0;


// UVFunc:17
	vec2 n_in17p1 = vec2(1.00000, 1.00000);
	vec2 n_out17p0 = n_out21p0 * n_in17p1 + n_out22p0;


	vec4 n_out25p0;
// Texture2D:25
	n_out25p0 = texture(NORMAL_MAP_WATER, n_out17p0);
	float n_out25p1 = n_out25p0.r;
	float n_out25p2 = n_out25p0.g;


// VectorCompose:3
	vec2 n_out3p0 = vec2(n_out25p1, n_out25p2);


// MultiplyAdd:9
	vec2 n_in9p1 = vec2(2.00000, 2.00000);
	vec2 n_in9p2 = vec2(-1.00000, -1.00000);
	vec2 n_out9p0 = fma(n_out3p0, n_in9p1, n_in9p2);


// FloatParameter:11
	float n_out11p0 = RefStregnht;


// Input:38
	vec4 n_out38p0 = COLOR;
	float n_out38p4 = n_out38p0.a;


	vec4 n_out47p0;
// Texture2D:47
	n_out47p0 = texture(Texture_mask, UV);
	float n_out47p1 = n_out47p0.r;


// FloatOp:45
	float n_out45p0 = n_out38p4 * n_out47p1;


// FloatOp:42
	float n_out42p0 = n_out11p0 * n_out45p0;


// VectorOp:10
	vec2 n_out10p0 = n_out9p0 * vec2(n_out42p0);


// VectorOp:5
	vec2 n_out5p0 = n_out4p0 - n_out10p0;


// Mix:31
	float n_in31p2 = 0.50000;
	vec2 n_out31p0 = mix(n_out4p0, n_out5p0, n_in31p2);


	vec2 n_out43p0;
// Switch:43
	n_out43p0 = mix(n_out5p0, n_out31p0, float(n_out44p0));


	vec4 n_out8p0;
// Texture2D:8
	n_out8p0 = texture(Texture2DParameter, n_out43p0);


// Output:0
	ALBEDO = vec3(n_out8p0.xyz);


}
