code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform sampler2D Texture_substract_2 : repeat_disable;
uniform vec2 Scale_Water = vec2(1.000000, 1.000000);
uniform vec2 Speed_X_Y = vec2(1.000000, 1.000000);
uniform sampler2D NORMAL_MAP_WATER : hint_normal, filter_linear;
uniform float RefStregnht = 0.01999999955297;
uniform sampler2D Texture2DParameter : source_color, filter_linear, repeat_disable, hint_screen_texture;
uniform vec2 Scale_XY = vec2(1.000000, 1.000000);
uniform vec2 Speed_XY;
uniform sampler2D Base_noise : source_color, repeat_enable;
uniform vec2 Substract_Scale_XY = vec2(1.000000, 1.000000);
uniform vec2 Substract_Speed_XY;
uniform sampler2D Texture_substract : source_color, hint_default_black, repeat_enable;
uniform float outter_margin = 1.29999995231628;
uniform float inner_margin = 0.15000000596046;
uniform sampler2D Gradient_Color_1D : source_color, repeat_disable;
uniform float Color_Intensity = 1;



void fragment() {
// Input:70
	vec2 n_out70p0 = SCREEN_UV;


// Input:89
	vec2 n_out89p0 = SCREEN_UV;


// Vector2Parameter:82
	vec2 n_out82p0 = Scale_Water;


// UVFunc:81
	vec2 n_in81p2 = vec2(0.00000, 0.00000);
	vec2 n_out81p0 = (n_out89p0 - n_in81p2) * n_out82p0 + n_in81p2;


// Input:78
	float n_out78p0 = TIME;


// Vector2Parameter:79
	vec2 n_out79p0 = Speed_X_Y;


// VectorOp:80
	vec2 n_out80p0 = vec2(n_out78p0) * n_out79p0;


// UVFunc:77
	vec2 n_in77p1 = vec2(1.00000, 1.00000);
	vec2 n_out77p0 = n_out80p0 * n_in77p1 + n_out81p0;


	vec4 n_out84p0;
// Texture2D:84
	n_out84p0 = texture(NORMAL_MAP_WATER, n_out77p0);
	float n_out84p1 = n_out84p0.r;
	float n_out84p2 = n_out84p0.g;


// VectorCompose:69
	vec2 n_out69p0 = vec2(n_out84p1, n_out84p2);


// MultiplyAdd:74
	vec2 n_in74p1 = vec2(2.00000, 2.00000);
	vec2 n_in74p2 = vec2(-1.00000, -1.00000);
	vec2 n_out74p0 = fma(n_out69p0, n_in74p1, n_in74p2);


// FloatParameter:76
	float n_out76p0 = RefStregnht;


// VectorOp:75
	vec2 n_out75p0 = n_out74p0 * vec2(n_out76p0);


// VectorOp:71
	vec2 n_out71p0 = n_out70p0 - n_out75p0;


	vec4 n_out73p0;
// Texture2D:73
	n_out73p0 = texture(Texture2DParameter, n_out71p0);


	vec4 n_out32p0;
// Texture2D:32
	n_out32p0 = texture(Texture_substract_2, UV);
	float n_out32p1 = n_out32p0.r;


// Vector2Parameter:13
	vec2 n_out13p0 = Scale_XY;


// UVFunc:9
	vec2 n_in9p2 = vec2(0.00000, 0.00000);
	vec2 n_out9p0 = (UV - n_in9p2) * n_out13p0 + n_in9p2;


// Vector2Parameter:11
	vec2 n_out11p0 = Speed_XY;


// Input:10
	float n_out10p0 = TIME;


// VectorOp:12
	vec2 n_out12p0 = n_out11p0 * vec2(n_out10p0);


// UVFunc:8
	vec2 n_in8p1 = vec2(1.00000, 1.00000);
	vec2 n_out8p0 = n_out12p0 * n_in8p1 + n_out9p0;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Base_noise, n_out8p0);
	float n_out3p1 = n_out3p0.r;


// Vector2Parameter:29
	vec2 n_out29p0 = Substract_Scale_XY;


// UVFunc:25
	vec2 n_in25p2 = vec2(0.00000, 0.00000);
	vec2 n_out25p0 = (UV - n_in25p2) * n_out29p0 + n_in25p2;


// Vector2Parameter:27
	vec2 n_out27p0 = Substract_Speed_XY;


// Input:26
	float n_out26p0 = TIME;


// VectorOp:28
	vec2 n_out28p0 = n_out27p0 * vec2(n_out26p0);


// UVFunc:24
	vec2 n_in24p1 = vec2(1.00000, 1.00000);
	vec2 n_out24p0 = n_out28p0 * n_in24p1 + n_out25p0;


	vec4 n_out6p0;
// Texture2D:6
	n_out6p0 = texture(Texture_substract, n_out24p0);
	float n_out6p1 = n_out6p0.r;


// FloatOp:15
	float n_out15p0 = n_out3p1 - n_out6p1;


// FloatParameter:35
	float n_out35p0 = outter_margin;


// FloatOp:30
	float n_out30p0 = pow(n_out15p0, n_out35p0);


// FloatOp:39
	float n_out39p0 = n_out32p1 - n_out30p0;


// FloatOp:38
	float n_in38p1 = 10.00000;
	float n_out38p0 = n_out39p0 * n_in38p1;


// Step:44
	float n_in44p0 = 0.00000;
	float n_out44p0 = step(n_in44p0, n_out38p0);


// Clamp:40
	float n_in40p1 = 0.00000;
	float n_in40p2 = 1.00000;
	float n_out40p0 = clamp(n_out44p0, n_in40p1, n_in40p2);


// FloatOp:41
	float n_in41p1 = -0.10000;
	float n_out41p0 = n_out40p0 + n_in41p1;


// FloatParameter:36
	float n_out36p0 = inner_margin;


// FloatOp:31
	float n_out31p0 = pow(n_out15p0, n_out36p0);


// FloatOp:34
	float n_out34p0 = n_out32p1 - n_out31p0;


// FloatOp:37
	float n_in37p1 = 10.00000;
	float n_out37p0 = n_out34p0 * n_in37p1;


// Clamp:16
	float n_in16p1 = 0.00000;
	float n_in16p2 = 1.00000;
	float n_out16p0 = clamp(n_out37p0, n_in16p1, n_in16p2);


// FloatOp:42
	float n_out42p0 = n_out41p0 + n_out16p0;


// FloatOp:45
	float n_out45p0 = n_out42p0 * n_out39p0;


	vec4 n_out51p0;
// Texture2D:51
	n_out51p0 = texture(Texture_substract_2, UV);
	float n_out51p1 = n_out51p0.r;


// Mix:46
	float n_out46p0 = mix(n_out45p0, n_out42p0, n_out51p1);


	vec4 n_out18p0;
// Texture2D:18
	n_out18p0 = texture(Gradient_Color_1D, vec2(n_out46p0));
	float n_out18p4 = n_out18p0.a;


// FloatParameter:20
	float n_out20p0 = Color_Intensity;


// VectorOp:19
	vec3 n_out19p0 = vec3(n_out18p0.xyz) * vec3(n_out20p0);


// Mix:68
	vec3 n_out68p0 = mix(vec3(n_out73p0.xyz), n_out19p0, vec3(n_out18p4));


// Output:0
	ALBEDO = n_out68p0;


}
