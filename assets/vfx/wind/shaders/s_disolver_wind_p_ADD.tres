[resource]
code = "shader_type spatial;
render_mode blend_add, depth_draw_opaque, cull_disabled, diffuse_toon, specular_toon, shadows_disabled;

uniform bool UseProximityFade = false;
uniform vec2 Scale = vec2(1.000000, 1.000000);
uniform vec2 Speed_XY;
uniform sampler2D Disolver_Texture : source_color, repeat_enable;
uniform bool UseFresnel = true;
uniform bool FresnelInvert = false;
uniform float FresnelPower = 1;
uniform float ProximityFade = 1;
uniform sampler2D depth_tex_frg_44 : hint_depth_texture;
uniform sampler2D Color_1D_Gradient : source_color, repeat_disable;
uniform float Intensity = 1;
uniform float Rought : hint_range(0, 1) = 0.80000001192093;
uniform float AlphaScissor : hint_range(0, 2) = 1;



void vertex() {
// GetBillboardMatrix:2
	// Node is disabled and code is not generated.
}

void fragment() {
// BooleanParameter:48
	bool n_out48p0 = UseProximityFade;


// Vector2Parameter:16
	vec2 n_out16p0 = Scale;


// UVFunc:15
	vec2 n_in15p2 = vec2(0.00000, 0.00000);
	vec2 n_out15p0 = (UV - n_in15p2) * n_out16p0 + n_in15p2;


// Vector2Parameter:21
	vec2 n_out21p0 = Speed_XY;


// Input:31
	float n_out31p0 = TIME;


// VectorOp:32
	vec2 n_out32p0 = n_out21p0 * vec2(n_out31p0);


// UVFunc:20
	vec2 n_in20p1 = vec2(1.00000, 1.00000);
	vec2 n_out20p0 = n_out32p0 * n_in20p1 + n_out15p0;


	vec4 n_out10p0;
// Texture2D:10
	n_out10p0 = texture(Disolver_Texture, n_out20p0);
	float n_out10p1 = n_out10p0.r;


// BooleanParameter:52
	bool n_out52p0 = UseFresnel;


// BooleanParameter:40
	bool n_out40p0 = FresnelInvert;


// FloatParameter:41
	float n_out41p0 = FresnelPower;


// Fresnel:39
	float n_out39p0 = n_out40p0 ? (pow(clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_out41p0)) : (pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_out41p0));


	float n_out53p0;
// Switch:53
	float n_in53p2 = 0.00000;
	n_out53p0 = mix(n_in53p2, n_out39p0, float(n_out52p0));


// FloatOp:42
	float n_out42p0 = n_out10p1 + n_out53p0;


// FloatParameter:47
	float n_out47p0 = ProximityFade;


	float n_out44p0;
// ProximityFade:44
	{
		float __depth_tex = texture(depth_tex_frg_44, SCREEN_UV).r;
		vec4 __depth_world_pos = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, __depth_tex, 1.0);
		__depth_world_pos.xyz /= __depth_world_pos.w;
		n_out44p0 = clamp(1.0 - smoothstep(__depth_world_pos.z + n_out47p0, __depth_world_pos.z, VERTEX.z), 0.0, 1.0);
	}


// FloatFunc:46
	float n_out46p0 = 1.0 - n_out44p0;


// FloatOp:45
	float n_out45p0 = n_out42p0 + n_out46p0;


	float n_out49p0;
// Switch:49
	n_out49p0 = mix(n_out42p0, n_out45p0, float(n_out48p0));


	vec4 n_out30p0;
// Texture2D:30
	n_out30p0 = texture(Color_1D_Gradient, vec2(n_out49p0));


// Input:36
	vec4 n_out36p0 = COLOR;


// VectorOp:35
	vec3 n_out35p0 = vec3(n_out30p0.xyz) * vec3(n_out36p0.xyz);


// FloatParameter:55
	float n_out55p0 = Intensity;


// VectorOp:54
	vec3 n_out54p0 = n_out35p0 * vec3(n_out55p0);


// FloatParameter:38
	float n_out38p0 = Rought;


// FloatParameter:50
	float n_out50p0 = AlphaScissor;


// Input:4
	vec4 n_out4p0 = COLOR;
	float n_out4p4 = n_out4p0.a;


// FloatOp:51
	float n_out51p0 = n_out50p0 * n_out4p4;


// Output:0
	ALBEDO = n_out54p0;
	ALPHA = n_out10p1;
	ROUGHNESS = n_out38p0;
	ALPHA_SCISSOR_THRESHOLD = n_out51p0;


}
"
